# ============================================================================
# OpenGenerate v2.0 — Environment Configuration Template (.env.example)
# Copy to `.env` and fill in real secrets before running `deploy/install.sh`
# ============================================================================

# PostgreSQL Database Credentials
POSTGRES_USER=opengenerate
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=opengenerate
OG_DATABASE_URL=postgresql://opengenerate:change_me_strong_db_password@postgres:5432/opengenerate

# Telegram Bot Token (Format: <bot_id>:<35_char_secret>)
OG_BOT_TOKEN=123456789:AAH_replace_with_real_telegram_bot_token

# Comma-separated numeric Telegram User IDs of platform Superadmins
OG_SUPERADMIN_IDS=111111111,222222222

# Comma-separated URL-safe base64 32-byte Fernet keys (first key is primary; older keys decrypt)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OG_ENCRYPTION_KEYS=replace_with_32_byte_urlsafe_base64_fernet_key=

# Runtime Environment: dev | test | staging | prod
OG_ENVIRONMENT=prod

# Operations HTTP Server (/livez, /readyz, /metrics)
OG_OPS_HOST=127.0.0.1
OG_OPS_PORT=8080
